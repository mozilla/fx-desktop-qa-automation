      "doNotCache"
    ],
    "shadowParent": "model-select",
    "comment": {
      "description": "Model in the open dropdown, by model choice id",
      "location": "Single-page onboarding (smartwindow-onboarding)"
    }
  },
  "memories-select": {
    "selectorData": "smartwindow-option-select#memories",
