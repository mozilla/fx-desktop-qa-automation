      "doNotCache"
    ],
    "shadowParent": "memories-select",
    "comment": {
      "description": "Button that opens the memories dropdown and shows the selected option",
      "location": "Single-page onboarding (smartwindow-onboarding)"
    }
  },
  "memories-options": {
