    ],
    "shadowParent": "model-select",
    "comment": {
      "description": "Every model in the open dropdown; data-value is the model choice id",
      "location": "Single-page onboarding (smartwindow-onboarding)"
    }
  },
  "model-option": {
    "selectorData": "button.option-item[data-value='{choice_id}']",
